{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:e2e": "npx pest --testsuite=Browser",
        "test:e2e:headed": "npx pest --testsuite=Browser --headed",
        "test:e2e:debug": "npx pest --testsuite=Browser --debug",
        "test:e2e:filter": "npx pest --testsuite=Browser --filter",
        "test:e2e:install": "npx playwright install --with-deps chromium",
        "test:e2e:serve": "php artisan serve --port=8080",
        "test:e2e:full": "concurrently -k \"npm run test:e2e:serve\" \"sleep 3 && npm run test:e2e\""
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@popperjs/core": "^2.11.8",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.15.0",
        "bootstrap": "^5.3.8",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "sass": "^1.99.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.2.2"
    },
    "name": "reposaplus",
    "version": "1.0.0"
}
