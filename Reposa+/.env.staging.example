APP_DEBUG=false
APP_URL=https://staging.reposaplus.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=reposaplus_mysql
DB_PORT=3306
DB_DATABASE=reposaplus_staging
DB_USERNAME=reposa_staging_user
DB_PASSWORD=secret_staging_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=redis
REDIS_HOST=reposaplus_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_staging_username
MAIL_PASSWORD=your_mailtrap_staging_password
